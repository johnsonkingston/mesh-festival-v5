doctype html
html(lang =lang)
    head 
        script(src="https://code.jquery.com/jquery-3.5.1.min.js" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous")
        script(src='https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.7.2/socket.io.js')
        link(href="//cdn-images.mailchimp.com/embedcode/classic-061523.css",rel="stylesheet",type="text/css")
        link(rel='stylesheet', type='text/css', href='static/styles/main.css')
        meta(name="viewport", content="width=device-width, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0")
        title=title
        meta(name="description",content="Mesh – Festival für Kunst und Technologie – Münchenstein / Basel")
        meta(property="og:title" content="Mesh – Festival für Kunst und Technologie – Münchenstein / Basel")
        meta(property="og:description", content="Multisensorische Erfahrungen, interaktive, immersive Erlebnisse und Installationen, Nachdenken über eine freundliche Zukunft")
        meta(property="og:type", content="website")
        meta(property="og:url", content="https://meshfestival.ch")

        meta(property="og:image" content="/static/img/favicon/android-chrome-512x512.png")
        meta(property="og:site_name" content="Mesh – Festival für Kunst und Technologie")

        link(rel="apple-touch-icon",sizes="180x180",href="/static/img/favicon/android-chrome-192x192.png")
        link(rel="icon",type="image/png",sizes="32x32",href="/static/img/favicon/favicon-32x32.png")
        link(rel="icon",type="image/png",sizes="16x16",href="/static/img/favicon/favicon-16x16.png")
        link(rel="mask-icon",href="/static/img/favicon/favicon_23.png",color="#000")
        meta(name="msapplication-TileColor",content="#000")
        meta(name="theme-color",content="#fff")
        link(rel="icon",type="image/png",href="/static/img/favicon/android-chrome-192x192.png")
        meta(name="robots",content="max-image-preview:large")
        meta(name="google-site-verification", content="TNAoxn34J4XEOzd8PTJtXvliDdC8DqZFmlmGiJ4_IxQ")

    body(class=newsContent ? '' : 'no-news')
        if newsContent
            #newsTicker
                .newsTickerTrack
                    .newsTickerInner!= newsContent
                    .newsTickerInner!= newsContent

        #mesh2024
            a(href="https://2024.meshfestival.ch" target="_blank").
                Mesh 2024
        #calltoaction
            a(href="https://meshfestival.ch/static/html/tickets.html" target="_blank").
                Get your Early Bird Ticket Now!


        .columnVideo.mobile
            video.mobileVideo(id="video",data-src="https://johnsonkingston.ch/MESH/Mesh_2026.mp4",autoplay="true",loop="true",muted="true",playsinline="true",poster="static/img/poster-video.jpg")        
        .columnTitle   
            h1 Mesh 
            h2 !{date.replace(/\n/g, "<br />")}
            h3 Freilager-Platz 
                br
                | Dreispitz Basel
            h4=infos

        script.
            function videoLoad(){ 
                    $('.mobileVideo').attr('src',$('.mobileVideo').attr('data-src'));  
                    $('.mobileVideo').attr('id','mainVideo');  
            }
            videoLoad();
        div.column
            div#statementContent.statement.section
 
                h1 !{theme.replace(/\n/g, "<br />")}

                h3
                    div!= statementContent

          
            div 


                .logos
                    // h3 !{infos.replace(/\n/g, "<br />")}

                    span=initiative
                    div.logobannerOuter
                        div.logobannerInner
                            each logo in logosLine1
                                if logo.href
                                    a(href=logo.href,target="_blank")
                                        img(src=logo.src,alt=logo.title,class=logo.tags)
                                else
                                    img(src=logo.src,alt=logo.title,class=logo.tags)
                    br
                    span=sponsor
                    div.logobannerOuter
                        div.logobannerInner.logobannerInnerSecond
                            each logo in logosLine2
                                if logo.href
                                    a(href=logo.href,target="_blank")
                                        img(src=logo.src,alt=logo.title,class=logo.tags).logofooter
                                else
                                    img(src=logo.src,alt=logo.title,class=logo.tags).logofooter

                    if logosLine3
                        br
                        span=logosLine3Title
                        div.logobannerThird!= logosLine3


                    div.footer
                        div
                            a(href="static/html/datenschutz.html" target="_blank")=disclaimer
                                br
                            a(href="static/html/imprint.html" target="_blank") Impressum
                        div
                            a(href="https://www.instagram.com/meshfestival/",target="_blank")
                                img(src="static/img/icons/sm-icon-02.svg")
                            a(href="https://www.linkedin.com/company/meshfestival",target="_blank")
                                img(src="static/img/icons/sm-icon-01.svg")
                            a(href="https://www.facebook.com/meshfestival/",target="_blank")
                                img(src="static/img/icons/sm-icon-03.svg")         
                        div 
                            a(href="mailto:media@meshfestival.ch",target="_blank") Kontakt: media@meshfestival.ch
                            br
                            a(href="https://confirmsubscription.com/h/i/50DBB2AA262DFFE1",target="_blank") Newsletter
        #lang
            a(href =(translation))=translation
        .videoSubtitleWrap(data-max="11")
        #cookieNotice.light.display-right(style='display: none;')
            #closeIcon(style='display: none;')
            .title-wrap
                h4 Cookie Consent
            .content-wrap
                .msg-wrap
                p
                    | By continuing to browse this site, you agree to the use of cookies. We use cookies to analyse web traffic. 
                    a(href='/static/html/datenschutz.html') Privacy Policy
                .btn-wrap
                    button.btn-primary(onclick='acceptCookieConsent();') Accept



        script. 
            let colors = !{JSON.stringify(colors)}
            var lang = 'EN';
            if('!{translation}' == 'EN'){
                lang = 'DE';
            }
        script(src='static/script/main.js')
