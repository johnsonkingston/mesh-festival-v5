doctype html
html(lang=language[0])
    include includes/head.pug
    script(src=baseURL+"static/script/artists.js")

    body.artists
        include includes/sitenav.pug

        //- translatable labels: [ de, en ] – indexed by languageParameter
        -
          var labels = {
            views: {
              formate: ['Formate', 'Formats'],
              themen: ['Themen', 'Topics'],
              az: ['A–Z', 'A–Z']
            },
            withoutTopic: ['Weitere Events', 'More events'],
            formats: {
              ausstellungen: ['Ausstellungen', 'Exhibitions'],
              konferenz: ['Konferenz', 'Conference'],
              performances: ['Performances', 'Performances'],
              diskurs: ['Talks & Panels', 'Talks & Panels'],
              screenings: ['Screenings', 'Screenings'],
              clubnights: ['Club Nights', 'Club Nights'],
              workshops: ['Workshops', 'Workshops']
            }
          };

        - var formatBefore = null
        - var themaBefore = null
        - var n = 0
        - function truncateWords(text, maxLen) { if (!text || text.length <= maxLen) return text; var cut = text.substr(0, maxLen); var lastSpace = cut.lastIndexOf(' '); if (lastSpace > 0) cut = cut.substr(0, lastSpace); return cut + '…'; }
        - var basePath = baseURL + 'artists' + (language[0] == 'en' ? '/en' : '')

        nav.viewNav
            each mode, index in ['formate','themen','az']
                a.bubble(href=basePath + (mode == 'formate' ? '' : '?sort=' + mode), class=(sort == mode ? 'active' : null), style="z-index:"+(3 - index))= labels.views[mode][languageParameter]

        main
            each event in events
                if(sort == 'formate' && formatBefore !== event.Format)
                    if(labels.formats[event.Format] !== undefined)
                        h2.formatHeader.blurOrganic1= labels.formats[event.Format][languageParameter]
                if(sort == 'themen')
                    - var thema = (event.Thema || '').trim()
                    if(themaBefore !== thema)
                        h2.formatHeader.blurOrganic1= thema || labels.withoutTopic[languageParameter]
                    - themaBefore = thema
                a(href=baseURL+'events/'+event.slug+'/'+language[0], class=event.Format).artistLine
                    .artist
                        .middle
                            if(sort !== 'formate' && labels.formats[event.Format] !== undefined)
                                h4.format= labels.formats[event.Format][languageParameter]
                            h3= '• '+(event.First_Name || '')+' '+(event.Name || '')
                            h4= truncateWords(event.Title, 40)
                - formatBefore = event.Format
                - n++

        include includes/footer.pug
