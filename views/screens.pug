doctype html
html(lang=language[0])
    head
        meta(charset="utf-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        meta(name="robots" content="noindex")
        title Mesh – Programm-Screens
        link(rel="icon" type="image/png" sizes="32x32" href=baseURL+"static/img/favicon/favicon-32x32.png")
        script(src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js")
        style.
            @font-face{font-family:"FreeSans-JK";src:url("#{baseURL}static/fonts/JK-MESH-Sans.woff2") format("woff2"),url("#{baseURL}static/fonts/JK-MESH-Sans.woff") format("woff");font-weight:700;font-display:swap;}
            @font-face{font-family:"FreeSerif-JK";src:url("#{baseURL}static/fonts/JK-MESH-Serif.woff2") format("woff2"),url("#{baseURL}static/fonts/JK-MESH-Serif.woff") format("woff");font-weight:500;font-display:swap;}

            :root{
                --bg:#ffffff;
                --ink:#333;
                --rule:rgba(51,51,51,.22);
            }
            *,*::before,*::after{box-sizing:border-box;}
            html,body{margin:0;}
            body{
                background:var(--bg);
                color:var(--ink);
                font-family:"FreeSans-JK",-apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif;
                -webkit-font-smoothing:antialiased;
                line-height:1.45;
            }
            .tool{max-width:1500px;margin:0 auto;padding:clamp(1.25rem,4vw,3rem);}
            .tool__head{margin-bottom:1.75rem;}
            .tool__head h1{
                font-family:"FreeSerif-JK",Georgia,serif;font-weight:500;
                font-size:clamp(1.9rem,4vw,2.9rem);margin:0 0 .4rem;
            }
            .tool__head p{margin:0;max-width:62ch;opacity:.82;}
            .tool__grid{
                display:grid;grid-template-columns:260px minmax(0,1fr);
                gap:clamp(1.5rem,4vw,3rem);align-items:start;
            }
            @media (max-width:860px){ .tool__grid{grid-template-columns:1fr;} }
            .controls{display:flex;flex-direction:column;gap:1.4rem;}
            .ctl-label{font-weight:700;font-size:.95rem;margin:0 0 .55rem;}
            .days{display:flex;flex-wrap:wrap;gap:.4rem;}
            .day-btn{
                font:inherit;font-weight:700;
                background:#fff;color:var(--ink);
                border:1px solid var(--rule);border-radius:2px;
                padding:.5rem .7rem;cursor:pointer;line-height:1.1;text-align:left;
            }
            .day-btn small{display:block;font-weight:400;opacity:.6;font-size:.78em;}
            .day-btn.is-active{background:var(--ink);color:var(--bg);border-color:var(--ink);}
            .day-btn.is-empty{opacity:.45;}
            .btn{
                font:inherit;font-weight:700;background:var(--ink);color:var(--bg);
                border:none;border-radius:2px;padding:.85rem 1.2rem;cursor:pointer;align-self:flex-start;
            }
            .btn:hover{opacity:.88;}
            .btn:disabled{opacity:.5;cursor:default;}
            .hint{font-size:.8rem;opacity:.65;margin:0;}

            .preview{display:flex;flex-wrap:wrap;gap:1.5rem;width:100%;}
            .slide{display:flex;flex-direction:column;gap:.6rem;flex:0 1 320px;max-width:320px;}
            .slide__title{font-weight:700;font-size:.9rem;margin:0;}
            .slide__export{align-self:flex-start;}
            .stage-clip{
                width:100%;
                border:1px solid var(--rule);background:var(--bg);
                overflow:hidden;
            }
            .stage{
                width:1080px;height:1920px;
                transform:scale(var(--scale,.4));transform-origin:top left;
            }

            /* ---- the exported poster: 1080 x 1920 (9:16), exported at 2x = 2160 x 3840 ---- */
            .poster-frame{
                position:relative;
                width:1080px;height:1920px;background:var(--bg);color:var(--ink);
                overflow:hidden;font-family:"FreeSans-JK",sans-serif;
            }
            /* full-bleed day artwork (2160 x 3840) – it carries the header + footer */
            .poster-frame .p-bg{position:absolute;inset:0;width:100%;height:100%;display:block;}
            /* the program table sits in the empty zone the artwork leaves free;
               tune top / bottom to match the artwork's header / footer bands */
            .poster-frame .p-content{
                position:absolute;left:0;right:0;top:132px;bottom:172px;
                padding:0 24px;overflow:hidden;
            }

            .p-table{width:100%;table-layout:fixed;border-collapse:collapse;}
            .p-table col.col-time{width:15%;}
            .p-table col.col-title{width:28%;}
            .p-table col.col-artist{width:37%;}
            .p-table col.col-venue{width:20%;}
            /* exhibitions have no fixed time slot - drop that column and
               redistribute its width across the remaining three */
            .p-table--noTime col.col-time{display:none;}
            .p-table--noTime td.c-time{display:none;}
            .p-table--noTime col.col-title{width:31%;}
            .p-table--noTime col.col-artist{width:45%;}
            .p-table--noTime col.col-venue{width:24%;}
            .p-table td{
                padding:11px 10px 11px 0px;border-bottom:1px solid var(--ink);
                font-size:22px;line-height:1.1;vertical-align:top;
                word-wrap:break-word;overflow-wrap:break-word;
            }
            .p-table td.c-title{font-weight:700;}
            .p-table td.c-time{white-space:nowrap;}
            .p-table tr.p-secrow td{
                border-bottom:none;padding:20px 0 5px;text-align:center;
            }
            .p-table .p-pill{
                display:inline-block;background:var(--ink);color:var(--bg);
                border-radius:8px;padding:.1em .28em;font-weight:500;font-size:22px;
            }
            .p-empty{margin-top:130px;text-align:center;font-size:26px;opacity:.55;}
    body
        main.tool
            header.tool__head
                h1 Programm-Screens
                p Drei Hochkant-Poster (9:16) gleichzeitig in der Vorschau – Performances &amp; Konferenz, restliches Programm, Ausstellungen – geordnet nach Format und innerhalb jedes Formats nach Zeit. Tag wählen, dann jedes Poster einzeln als JPG (2160 × 3840) herunterladen.
            .tool__grid
                .controls
                    div
                        p.ctl-label Tag
                        .days#days
                    p.hint 9:16 · 2160 × 3840 px · JPG
                .preview
                    .slide
                        h2.slide__title Slide 1 · Performances &amp; Konferenz
                        .stage-clip#stageClip1
                            .stage#stage1
                                .poster-frame#poster1
                                    img.p-bg#bgImg1(alt="")
                                    .p-content
                                        table.p-table#posterTable1
                                            colgroup
                                                col.col-time
                                                col.col-title
                                                col.col-artist
                                                col.col-venue
                                            tbody#tbody1
                        button.btn.slide__export(type="button" data-slide-index="0") JPG herunterladen / Download JPG
                    .slide
                        h2.slide__title Slide 2 · Programm
                        .stage-clip#stageClip2
                            .stage#stage2
                                .poster-frame#poster2
                                    img.p-bg#bgImg2(alt="")
                                    .p-content
                                        table.p-table#posterTable2
                                            colgroup
                                                col.col-time
                                                col.col-title
                                                col.col-artist
                                                col.col-venue
                                            tbody#tbody2
                        button.btn.slide__export(type="button" data-slide-index="1") JPG herunterladen / Download JPG
                    .slide
                        h2.slide__title Slide 3 · Ausstellungen
                        .stage-clip#stageClip3
                            .stage#stage3
                                .poster-frame#poster3
                                    img.p-bg#bgImg3(alt="")
                                    .p-content
                                        table.p-table#posterTable3
                                            colgroup
                                                col.col-time
                                                col.col-title
                                                col.col-artist
                                                col.col-venue
                                            tbody#tbody3
                        button.btn.slide__export(type="button" data-slide-index="2") JPG herunterladen / Download JPG
        script.
            (function(){
                var EVENTS = !{JSON.stringify(screenEvents)};
                var LANG = !{JSON.stringify(language)};
                var BASE = "#{baseURL}";

                var FORMAT_LABEL = {
                    ausstellungen:"Ausstellungen", performances:"Performances", screenings:"Screenings",
                    konferenz:"Konferenz", workshop:"Workshop", workshops:"Workshops", satellite:"Satellite", diskurs:"Talks & Panels",
                    clubnights:"Club Nights", guided_tour:"Rundgang", welcoming:"Welcome", welcomming:"Welcoming"
                };

                // Three simultaneous slides, each its own poster:
                // 1) Performances & Konferenz, 2) the rest of the timed programme
                // (except exhibitions), 3) exhibitions only (own fixed artwork,
                // no day-specific time slots - see "dayIndependent" below).
                // "workshop" (singular) is the actual CMS value - "workshops" is kept only as
                // a defensive fallback in case the CMS spelling ever changes.
                var SLIDES = [
                    { id:"performances-konferenz", label:"Performances & Konferenz", formats:["performances","konferenz"], dayIndependent:false },
                    { id:"programm", label:"Programm", formats:["welcoming","welcomming","screenings","workshop","workshops","satellite","guided_tour","diskurs","clubnights"], dayIndependent:false },
                    { id:"ausstellungen", label:"Ausstellungen", formats:["ausstellungen"], dayIndependent:true }
                ];
                var DAYS = [
                    ["14","Mittwoch","14.10.2026","Mi"],
                    ["15","Donnerstag","15.10.2026","Do"],
                    ["16","Freitag","16.10.2026","Fr"],
                    ["17","Samstag","17.10.2026","Sa"],
                    ["18","Sonntag","18.10.2026","So"]
                ];

                var daysEl = document.getElementById("days");
                var currentDay = null;

                SLIDES.forEach(function(slide, i){
                    var n = i + 1;
                    slide.els = {
                        stageClip: document.getElementById("stageClip" + n),
                        stage: document.getElementById("stage" + n),
                        poster: document.getElementById("poster" + n),
                        bgImg: document.getElementById("bgImg" + n),
                        posterTable: document.getElementById("posterTable" + n),
                        tbody: document.getElementById("tbody" + n),
                        exportBtn: document.querySelector('.slide__export[data-slide-index="' + i + '"]')
                    };
                    slide.bgReady = Promise.resolve();
                });

                function pad(n){ return (n < 10 ? "0" : "") + n; }

                function fmtTime(ev){
                    if(ev.hourStart == null) return ""; // exhibitions run all festival long, no fixed slot
                    var s = pad(ev.hourStart % 24) + ":" + pad(ev.minStart);
                    if(ev.hourEnd != null && !isNaN(ev.hourEnd)){
                        s += " – " + pad(Math.floor(ev.hourEnd) % 24) + ":" + pad(ev.minEnd);
                    }
                    return s;
                }

                function dayHasEvents(code){
                    return EVENTS.some(function(e){ return e.day === code; });
                }

                function el(tag, cls, text){
                    var n = document.createElement(tag);
                    if(cls) n.className = cls;
                    if(text != null) n.textContent = text;
                    return n;
                }
                function td(cls, text){ return el("td", cls, text); }

                function onceLoaded(img){
                    return new Promise(function(resolve){
                        if(img.complete && img.naturalWidth){ resolve(); return; }
                        img.onload = function(){ resolve(); };
                        img.onerror = function(){ resolve(); };
                    });
                }
                function setBackground(slide, code){
                    var src = BASE + "static/img/screens/" + code + ".jpg";
                    if(slide.els.bgImg.getAttribute("src") !== src){ slide.els.bgImg.src = src; }
                    slide.bgReady = onceLoaded(slide.els.bgImg);
                }

                function buildPoster(slide){
                    // the "Ausstellungen" slide has its own fixed artwork, independent
                    // of the selected day - every other slide uses the day's own image.
                    var code = slide.dayIndependent ? "ausstellungen" : currentDay;
                    setBackground(slide, code);

                    // exhibitions have no fixed time slot (drop that column) and are the
                    // only format on that slide (skip the redundant section header/pill).
                    slide.els.posterTable.classList.toggle("p-table--noTime", slide.dayIndependent);

                    slide.els.tbody.innerHTML = "";
                    var any = false;

                    slide.formats.forEach(function(fmt){
                        var evs = EVENTS.filter(function(e){ return e.day === code && e.format === fmt; });
                        if(!evs.length) return;
                        any = true;
                        evs.sort(function(a, b){
                            // exhibitions have no time slot to sort by - alphabetical instead
                            if(a.hourStart == null || b.hourStart == null){
                                return (a.title || "").localeCompare(b.title || "");
                            }
                            return (a.hourStart * 60 + a.minStart) - (b.hourStart * 60 + b.minStart);
                        });

                        if(!slide.dayIndependent){
                            var secTr = el("tr", "p-secrow");
                            var secTd = document.createElement("td");
                            secTd.colSpan = 4;
                            secTd.appendChild(el("span", "p-pill", FORMAT_LABEL[fmt] || fmt));
                            secTr.appendChild(secTd);
                            slide.els.tbody.appendChild(secTr);
                        }

                        evs.forEach(function(ev){
                            var tr = document.createElement("tr");
                            tr.appendChild(td("c-time", fmtTime(ev)));
                            var cTitle = td("c-title");
                            cTitle.appendChild(document.createTextNode(ev.title || ""));
                            tr.appendChild(cTitle);
                            tr.appendChild(td("c-artist", ev.artist || ""));
                            tr.appendChild(td("c-venue", ev.venue || ""));
                            slide.els.tbody.appendChild(tr);
                        });
                    });

                    if(!any){
                        var tr = document.createElement("tr");
                        var c = document.createElement("td");
                        c.colSpan = 4;
                        c.appendChild(el("div", "p-empty", "Kein Eintrag an diesem Tag"));
                        tr.appendChild(c);
                        slide.els.tbody.appendChild(tr);
                    }
                }

                function buildAllPosters(){
                    SLIDES.forEach(buildPoster);
                }

                function buildDayButtons(){
                    DAYS.forEach(function(d){
                        var b = el("button", "day-btn");
                        b.type = "button";
                        b.dataset.day = d[0];
                        b.appendChild(document.createTextNode(d[3] + " · " + d[1]));
                        b.appendChild(el("small", null, d[2]));
                        if(!dayHasEvents(d[0])) b.classList.add("is-empty");
                        b.addEventListener("click", function(){ selectDay(d[0]); });
                        daysEl.appendChild(b);
                    });
                }

                function selectDay(code){
                    currentDay = code;
                    Array.prototype.forEach.call(daysEl.children, function(b){
                        b.classList.toggle("is-active", b.dataset.day === code);
                    });
                    buildAllPosters();
                }

                function fitStage(slide){
                    var w = slide.els.stageClip.clientWidth;
                    var s = w / 1080;
                    slide.els.stage.style.setProperty("--scale", s);
                    slide.els.stageClip.style.height = (1920 * s) + "px";
                }
                function fitAllStages(){ SLIDES.forEach(fitStage); }

                function fileName(slide){
                    if(slide.dayIndependent){
                        return "mesh-" + slide.id + ".jpg";
                    }
                    var meta = DAYS.filter(function(d){ return d[0] === currentDay; })[0] || ["day", "day"];
                    return "mesh-" + slide.id + "-" + meta[0] + "-" + String(meta[1]).toLowerCase() + ".jpg";
                }

                async function ensureFonts(){
                    if(!document.fonts || !document.fonts.load) return;
                    try{
                        await Promise.all([
                            document.fonts.load('700 40px "FreeSans-JK"'),
                            document.fonts.load('400 24px "FreeSans-JK"')
                        ]);
                        await document.fonts.ready;
                    }catch(e){ /* fall back to system fonts */ }
                }

                async function exportJPG(slide){
                    if(typeof html2canvas === "undefined"){
                        alert("html2canvas konnte nicht geladen werden (CDN blockiert?).");
                        return;
                    }
                    var btn = slide.els.exportBtn;
                    var label = btn.textContent;
                    btn.disabled = true;
                    btn.textContent = "Wird erstellt …";

                    // Render the poster un-transformed and off-screen so html2canvas
                    // captures it at its true 1080 x 1920 (a CSS transform on an
                    // ancestor confuses html2canvas otherwise).
                    var stage = slide.els.stage;
                    var stageClip = slide.els.stageClip;
                    var saved = {
                        transform: stage.style.transform,
                        position: stageClip.style.position,
                        left: stageClip.style.left,
                        top: stageClip.style.top,
                        overflow: stageClip.style.overflow,
                        height: stageClip.style.height,
                        maxWidth: stageClip.style.maxWidth,
                        width: stageClip.style.width
                    };
                    stage.style.transform = "none";
                    stageClip.style.position = "fixed";
                    stageClip.style.left = "-100000px";
                    stageClip.style.top = "0";
                    stageClip.style.overflow = "visible";
                    stageClip.style.height = "1920px";
                    stageClip.style.maxWidth = "none";
                    stageClip.style.width = "1080px";

                    try{
                        await ensureFonts();
                        await slide.bgReady;
                        var canvas = await html2canvas(slide.els.poster, {
                            scale: 2,
                            backgroundColor: "#fef7f6",
                            width: 1080,
                            height: 1920,
                            windowWidth: 1080,
                            windowHeight: 1920,
                            useCORS: true,
                            imageTimeout: 15000
                        });
                        await new Promise(function(resolve, reject){
                            canvas.toBlob(function(blob){
                                if(!blob){ reject(new Error("JPG konnte nicht erstellt werden.")); return; }
                                var url = URL.createObjectURL(blob);
                                var a = document.createElement("a");
                                a.href = url;
                                a.download = fileName(slide);
                                document.body.appendChild(a);
                                a.click();
                                a.remove();
                                setTimeout(function(){ URL.revokeObjectURL(url); }, 4000);
                                resolve();
                            }, "image/jpeg", 0.92);
                        });
                    }catch(err){
                        alert("Fehler: " + err.message);
                    }finally{
                        stage.style.transform = saved.transform;
                        stageClip.style.position = saved.position;
                        stageClip.style.left = saved.left;
                        stageClip.style.top = saved.top;
                        stageClip.style.overflow = saved.overflow;
                        stageClip.style.height = saved.height;
                        stageClip.style.maxWidth = saved.maxWidth;
                        stageClip.style.width = saved.width;
                        fitStage(slide);
                        btn.disabled = false;
                        btn.textContent = label;
                    }
                }

                SLIDES.forEach(function(slide){
                    slide.els.exportBtn.addEventListener("click", function(){ exportJPG(slide); });
                });
                window.addEventListener("resize", fitAllStages);

                buildDayButtons();
                fitAllStages();
                var firstWithEvents = DAYS.filter(function(d){ return dayHasEvents(d[0]); })[0];
                selectDay(firstWithEvents ? firstWithEvents[0] : DAYS[0][0]);
            })();
