doctype html
html(lang=language[0])
    include includes/head.pug
    link(rel="stylesheet", href="/node_modules/swiper/swiper-bundle.min.css")
    script(src="/node_modules/swiper/swiper-bundle.min.js")
    body.startpage
        include includes/sitenav.pug
        main
            a#mesh2024.bubble(href="https://2024.meshfestival.ch" target="_blank") Mesh 2024
            //a#calltoaction.bubble(href="https://meshfestival.ch/static/html/tickets.html" target="_blank") Tickets


            .columnTitle
                h1.blurOrganic2 Mesh
                h4.blurOrganic1 Festival für Kunst und Technologie
                h2.blurOrganic1-5
                    | 14.–18.
                    br
                    | Oktober 2026
                h4.place.blurOrganic1 Dreispitz Basel
            - var slide0 = (slides && slides.length > 0) ? slides[0] : null
            - var slide0Translation = (slide0 && slide0.translations && slide0.translations.length > 0) ? (slide0.translations[languageParameter] || slide0.translations[0]) : null
            - var slide0EventHref = (slide0 && slide0.eventSlug) ? (baseURL + 'timetable/' + language[0] + '?event=' + slide0.eventSlug) : null
            .editionTitle
                if slide0Translation
                    a#sliderTextLink(href=slide0EventHref)
                        h2.blurOrganic1#sliderTagline= slide0Translation.Title
                        h1.blurOrganic1-5#sliderHeadline= slide0Translation.Text
                else if data.translations && data.translations.length > 0
                    h2.blurOrganic1 Edition 2026
                    if(data.translations[languageParameter] === undefined)
                        h1.blurOrganic1-5= data.translations[0].Title
                    else
                        h1.blurOrganic1-5= data.translations[languageParameter].Title
            .columnVideo.mobile
                if slides && slides.length > 0
                    .swiper.meshSlider
                        .swiper-wrapper
                            each slide, i in slides
                                - var slideTranslation = (slide.translations && slide.translations.length > 0) ? (slide.translations[languageParameter] || slide.translations[0]) : null
                                - var slideIsVideo = slide.File && slide.File.type && slide.File.type.indexOf('video') === 0
                                - var slideEventHref = slide.eventSlug ? (baseURL + 'timetable/' + language[0] + '?event=' + slide.eventSlug) : ''
                                .swiper-slide(data-title=slideTranslation ? slideTranslation.Title : '',data-text=slideTranslation ? slideTranslation.Text : '',data-event-href=slideEventHref)
                                    if slideIsVideo
                                        if i === 0
                                            video.mobileVideo(loop="true",muted="true",playsinline="true",poster="/static/img/mesh-festival-background.jpg",src=imgURL+slide.File.filename_disk)
                                        else
                                            video.mobileVideo(loop="true",muted="true",playsinline="true",poster="/static/img/mesh-festival-background.jpg",data-src=imgURL+slide.File.filename_disk)
                                    else
                                        if i === 0
                                            img.mobileVideo(alt=slideTranslation ? slideTranslation.Title : '',src=imgURL+slide.File.filename_disk+'?key=fullscreen')
                                        else
                                            img.mobileVideo(alt=slideTranslation ? slideTranslation.Title : '',data-src=imgURL+slide.File.filename_disk+'?key=fullscreen',src="/static/img/mesh-festival-background.jpg")
                        if slides.length > 1
                            .swiper-pagination
                else
                    video.mobileVideo(data-src="https://johnsonkingston.ch/MESH/Mesh-2026-Querformat-2.mp4",autoplay="true",loop="true",muted="true",playsinline="true",poster="/static/img/mesh-festival-background.jpg")
            .columnTitleBottom
                h2
                    | 14.–18. 
                    span.right Oktober
                    br
                    | 2026
                h4 Festival für Kunst und Technologie
                h3 Dreispitz Basel
            if newsContent
                #newsTicker
                    .newsTickerTrack
                        .newsTickerInner!= newsContent
                        .newsTickerInner!= newsContent
            div.column
                div#statementContent.statement.section
                    if data.translations && data.translations.length > 0
                        if(data.translations[languageParameter] === undefined)
                            h1.blurOrganic2= data.translations[0].Title
                            .content !{data.translations[0].Content_Service_Website}
                        else
                            h1.blurOrganic2= data.translations[languageParameter].Title
                            .content !{data.translations[languageParameter].Content_Service_Website}

                div
                    .logos
                        // h3 !{infos.replace(/\n/g, "<br />")}

                        span=initiative
                        div.logobannerOuter
                            div.logobannerInner
                                each logo in logosLine1
                                    if logo.href
                                        a(href=logo.href,target="_blank")
                                            img(src=logo.src,alt=logo.title,class=logo.tags)
                                    else
                                        img(src=logo.src,alt=logo.title,class=logo.tags)
                        br
                        span=sponsor
                        div.logobannerOuter
                            div.logobannerInner.logobannerInnerSecond
                                each logo in logosLine2
                                    if logo.href
                                        a(href=logo.href,target="_blank")
                                            img(src=logo.src,alt=logo.title,class=logo.tags).logofooter
                                    else
                                        img(src=logo.src,alt=logo.title,class=logo.tags).logofooter

                        if logosLine3
                            br
                            span=logosLine3Title
                            div.logobannerThird!= logosLine3

                        br
                        br

            script.
                function meshLoadSlideMedia(slideEl){
                    var media = slideEl && slideEl.querySelector('.mobileVideo[data-src]');
                    if (!media) return;
                    var src = media.getAttribute('data-src');
                    media.removeAttribute('data-src');
                    media.setAttribute('src', src);
                    if (media.tagName === 'VIDEO') media.play().catch(function(){});
                }

                function meshPreloadNeighbors(swiper){
                    meshLoadSlideMedia(swiper.slides[swiper.activeIndex]);
                    meshLoadSlideMedia(swiper.slides[swiper.activeIndex + 1]);
                }

                function meshSyncVideos(swiper){
                    var activeSlide = swiper.slides[swiper.activeIndex];
                    for (var i = 0; i < swiper.slides.length; i++) {
                        var video = swiper.slides[i].querySelector('video.mobileVideo');
                        if (!video) continue;
                        if (swiper.slides[i] === activeSlide) {
                            video.play().catch(function(){});
                        } else {
                            video.pause();
                        }
                    }
                }

                function meshUpdateText(swiper){
                    var tagline = document.getElementById('sliderTagline');
                    var headline = document.getElementById('sliderHeadline');
                    var link = document.getElementById('sliderTextLink');
                    var activeSlide = swiper.slides[swiper.activeIndex];
                    if (!activeSlide || (!tagline && !headline)) return;
                    var title = activeSlide.getAttribute('data-title') || '';
                    var text = activeSlide.getAttribute('data-text') || '';
                    var href = activeSlide.getAttribute('data-event-href') || '';
                    if (tagline) tagline.classList.add('sliderFading');
                    if (headline) headline.classList.add('sliderFading');
                    setTimeout(function(){
                        if (tagline) tagline.textContent = title;
                        if (headline) headline.textContent = text;
                        if (link) {
                            if (href) link.setAttribute('href', href);
                            else link.removeAttribute('href');
                        }
                        if (tagline) tagline.classList.remove('sliderFading');
                        if (headline) headline.classList.remove('sliderFading');
                    }, 450);
                }

                var meshSwiperEl = document.querySelector('.meshSlider');
                if (meshSwiperEl && typeof Swiper !== 'undefined') {
                    var meshMultiSlide = meshSwiperEl.querySelectorAll('.swiper-slide').length > 1;
                    var meshSwiper = new Swiper(meshSwiperEl, {
                        loop: meshMultiSlide,
                        speed: 400,
                        autoplay: meshMultiSlide ? { delay: 6000, disableOnInteraction: false } : false,
                        pagination: meshMultiSlide ? { el: '.swiper-pagination', clickable: true } : false,
                        on: {
                            init: function(swiper){
                                meshPreloadNeighbors(swiper);
                                meshSyncVideos(swiper);
                            },
                            slideChangeTransitionStart: function(swiper){
                                meshUpdateText(swiper);
                            },
                            slideChangeTransitionEnd: function(swiper){
                                meshPreloadNeighbors(swiper);
                                meshSyncVideos(swiper);
                            }
                        }
                    });
                    document.addEventListener('visibilitychange', function(){
                        if (document.visibilityState !== 'visible') return;
                        var activeSlide = meshSwiper.slides[meshSwiper.activeIndex];
                        var video = activeSlide && activeSlide.querySelector('video.mobileVideo');
                        if (video && video.paused && video.getAttribute('src')) video.play().catch(function(){});
                    });
                } else {
                    var fallbackMedia = document.querySelector('.columnVideo > .mobileVideo[data-src]');
                    if (fallbackMedia) {
                        var fallbackSrc = fallbackMedia.getAttribute('data-src');
                        if (fallbackSrc) fallbackMedia.setAttribute('src', fallbackSrc);
                    }
                }
            include includes/footer.pug



            #cookieNotice.light.display-right(style='display: none;')
                #closeIcon(style='display: none;')
                .title-wrap
                    h4 Cookie Consent
                .content-wrap
                    .msg-wrap
                    p
                        | By continuing to browse this site, you agree to the use of cookies. We use cookies to analyse web traffic.
                        a(href='/static/html/datenschutz.html') Privacy Policy
                    .btn-wrap
                        button.btn-primary(onclick='acceptCookieConsent();') Accept

            script.
                var lang = '!{language[0].toUpperCase()}';
