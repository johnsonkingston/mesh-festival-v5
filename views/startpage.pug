                            span=logosLine3Title
                            div.logobannerThird!= logosLine3

                        br
                        br

            script.
                var meshSlides = (typeof slides !== 'undefined' && slides) ? slides : [];
                var meshSlideIndex = 0;
                var meshSlideIntervalMs = 6000;
                var meshTransitionMs = 900;
                var meshSliderTimer = null;
                var meshActiveLayerId = 'sliderLayerA';

                function meshOtherLayerId(id){
                    return id === 'sliderLayerA' ? 'sliderLayerB' : 'sliderLayerA';
                }

                function meshBuildMedia(slide){
                    if (!slide || !slide.File) return null;
                    var isVideo = slide.File.type && slide.File.type.indexOf('video') === 0;
                    var src = 'https://env-9468449.appengine.flow.ch/assets/' + slide.File.filename_disk + (isVideo ? '' : '?key=fullscreen');
                    var mediaEl = document.createElement(isVideo ? 'video' : 'img');
                    mediaEl.className = 'mobileVideo sliderMedia';
                    if (isVideo) {
                        mediaEl.loop = true;
                        mediaEl.muted = true;
                        mediaEl.setAttribute('playsinline', '');
                        mediaEl.setAttribute('poster', '/static/img/mesh-festival-background.jpg');
                    }
                    mediaEl.src = src;
                    return mediaEl;
                }

                function meshSetLayerMedia(layerEl, slide, index){
                    if (!layerEl) return;
                    layerEl.innerHTML = '';
                    layerEl.setAttribute('data-slide-index', index);
                    var mediaEl = meshBuildMedia(slide);
                    if (mediaEl) layerEl.appendChild(mediaEl);
                }

                function meshPlayLayer(layerEl){
                    var mediaEl = layerEl && layerEl.querySelector('video.sliderMedia');
                    if (mediaEl) mediaEl.play().catch(function(){});
                }

                function meshPauseLayer(layerEl){
                    var mediaEl = layerEl && layerEl.querySelector('video.sliderMedia');
                    if (mediaEl) mediaEl.pause();
                }

                function meshPreloadNext(afterIndex){
                    if (meshSlides.length < 2) return;
                    var nextLayer = document.getElementById(meshOtherLayerId(meshActiveLayerId));
                    var preloadIndex = (afterIndex + 1) % meshSlides.length;
                    meshSetLayerMedia(nextLayer, meshSlides[preloadIndex], preloadIndex);
                }

                function meshRenderSlideText(slide){
                    var tagline = document.getElementById('sliderTagline');
                    var headline = document.getElementById('sliderHeadline');
                    var link = document.getElementById('sliderTextLink');
                    if (!slide || !slide.translations || (!tagline && !headline)) return;
                    var t = slide.translations[languageParameter] || slide.translations[0];
                    if (!t) return;
                    if (tagline) tagline.classList.add('sliderFading');
                    if (headline) headline.classList.add('sliderFading');
                    setTimeout(function(){
                        if (tagline) tagline.textContent = t.Title;
                        if (headline) headline.textContent = t.Text;
                        if (link) {
                            if (slide.eventSlug) {
                                link.setAttribute('href', baseURL + 'timetable/' + language[0] + '?event=' + slide.eventSlug);
                            } else {
                                link.removeAttribute('href');
                            }
                        }
                        if (tagline) tagline.classList.remove('sliderFading');
                        if (headline) headline.classList.remove('sliderFading');
                    }, meshTransitionMs / 2);
                }

                function meshUpdateDots(index){
                    var dots = document.querySelectorAll('.sliderDot');
                    for (var i = 0; i < dots.length; i++) {
                        dots[i].classList.toggle('active', i === index);
                    }
                }

                function meshGoToSlide(index){
                    if (!meshSlides.length || index === meshSlideIndex) return;

                    var activeLayer = document.getElementById(meshActiveLayerId);
                    var nextLayerId = meshOtherLayerId(meshActiveLayerId);
                    var nextLayer = document.getElementById(nextLayerId);

                    if (parseInt(nextLayer.getAttribute('data-slide-index'), 10) !== index) {
                        meshSetLayerMedia(nextLayer, meshSlides[index], index);
                    }

                    void nextLayer.offsetWidth;
                    nextLayer.classList.remove('sliderLayerNext');
                    nextLayer.classList.add('active');
                    activeLayer.classList.add('sliderLayerExit');
                    activeLayer.classList.remove('active');

                    meshPlayLayer(nextLayer);
                    meshRenderSlideText(meshSlides[index]);
                    meshUpdateDots(index);

                    var exitingLayer = activeLayer;
                    setTimeout(function(){
                        meshPauseLayer(exitingLayer);
                        exitingLayer.innerHTML = '';
                        exitingLayer.removeAttribute('data-slide-index');
                        exitingLayer.classList.remove('sliderLayerExit');
                        exitingLayer.classList.add('sliderLayerNext');
                        meshPreloadNext(index);
                    }, meshTransitionMs);

                    meshActiveLayerId = nextLayerId;
                    meshSlideIndex = index;
                }

                function meshNextSlide(){
                    if (meshSlides.length < 2) return;
                    meshGoToSlide((meshSlideIndex + 1) % meshSlides.length);
                }

                function meshStartSlider(){
                    if (meshSlides.length < 2) return;
                    meshSliderTimer = setInterval(meshNextSlide, meshSlideIntervalMs);
                }

                function meshRestartSlider(){
                    if (meshSliderTimer) clearInterval(meshSliderTimer);
                    meshStartSlider();
                }

                function resumeActiveSliderVideo(){
                    if (document.visibilityState !== 'visible') return;
                    var activeLayer = document.getElementById(meshActiveLayerId);
                    var mediaEl = activeLayer && activeLayer.querySelector('video.sliderMedia');
                    if (mediaEl && mediaEl.paused) mediaEl.play().catch(function(){});
                }
                document.addEventListener('visibilitychange', resumeActiveSliderVideo);

                function sliderLoad(){
                    var firstLayer = document.getElementById('sliderLayerA');
                    if (!firstLayer) {
                        var fallbackMedia = document.querySelector('.columnVideo > .mobileVideo[data-src]');
                        if (fallbackMedia) {
                            var fallbackSrc = fallbackMedia.getAttribute('data-src');
                            if (fallbackSrc) fallbackMedia.setAttribute('src', fallbackSrc);
                        }
                        return;
                    }
                    var firstMedia = firstLayer.querySelector('.sliderMedia');
                    if (firstMedia) {
                        var dataSrc = firstMedia.getAttribute('data-src');
                        if (dataSrc) firstMedia.setAttribute('src', dataSrc);
                        if (firstMedia.tagName === 'VIDEO') firstMedia.play().catch(function(){});
                    }
                    meshPreloadNext(0);

                    var dots = document.querySelectorAll('.sliderDot');
                    for (var i = 0; i < dots.length; i++) {
                        dots[i].addEventListener('click', function(){
                            var index = parseInt(this.getAttribute('data-slide-index'), 10);
                            if (!isNaN(index) && index !== meshSlideIndex) {
                                meshGoToSlide(index);
                                meshRestartSlider();
                            }
                        });
                    }
                }

                sliderLoad();
                meshStartSlider();
            include includes/footer.pug



