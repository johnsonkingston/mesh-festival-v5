doctype html
html(lang=language[0])
    include includes/head.pug
    body.page.event
        main
            h4.format= data.formatTranslation[languageParameter]   
            h4= data.Thema   
            h1.blurOrganic1-5= data.Artist
            h3.blurOrganic1-5= data.translations[languageParameter].Title
            
            if data.Main_Image == null
                img.mainimage(src=imgURL+'5a7095f3-d054-4527-8bb8-998de11e6d28.png')
            else if data.Main_Image.type && data.Main_Image.type.indexOf('video/') === 0
                .mainimageWrap
                    video.mainimage#mainVideo(src=imgURL+data.Main_Image.filename_disk, autoplay, muted, loop, playsinline)
                    button.unmuteBtn.mediaBtn.is-muted#unmuteBtn(type="button", onclick="toggleMainVideoSound()", aria-label="Ton aktivieren")
                        svg.iconMuted(viewBox="0 0 24 24" width="20" height="20" aria-hidden="true")
                            path(d="M4 9v6h4l5 5V4L8 9H4z", fill="currentColor")
                            path(d="M16.5 8.5l6 6M22.5 8.5l-6 6", stroke="currentColor", stroke-width="2", stroke-linecap="round")
                        svg.iconUnmuted(viewBox="0 0 24 24" width="20" height="20" aria-hidden="true")
                            path(d="M4 9v6h4l5 5V4L8 9H4z", fill="currentColor")
                            path(d="M16 8a5 5 0 010 8M19 5a9 9 0 010 14", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round")
                    button.playPauseBtn.mediaBtn#playPauseBtn(type="button", aria-label="Pause")
                        svg.iconPause(viewBox="0 0 24 24" width="20" height="20" aria-hidden="true")
                            path(d="M6 5h4v14H6zM14 5h4v14h-4z", fill="currentColor")
                        svg.iconPlay(viewBox="0 0 24 24" width="20" height="20" aria-hidden="true")
                            path(d="M7 4l13 8-13 8V4z", fill="currentColor")
                if data.Main_Image.title
                    .mainimageCaption.mediaCaption= data.Main_Image.title
            else
                picture
                    source(media="min-width:650px",srcset=imgURL+data.Main_Image.filename_disk+'?key=content')
                    img.mainimage(src=imgURL+data.Main_Image.filename_disk+'?key=fullscreen', alt=data.Main_Image.title)
                if data.Main_Image.title
                    .mainimageCaption.mediaCaption= data.Main_Image.title


            .eventHeader 
                .eventHeaderColumn
                    if data.translations[languageParameter].Time_frontend
                        p !{data.translations[languageParameter].Time_frontend.replace(/\n/g, '<br/>')}
                    if data.Display_Time
                        if(languageParameter == 0)
                            if(data.time_transformed_de !== undefined)
                                p= data.time_transformed_de.start
                        else
                            p= data.time_transformed.start
                    
                    if data.Venues.length > 0
                        a(href=baseURL+'pages/locations/'+language[0], target="_top")
                            p= data.Venues[0].Venues_id.Name
                    //p= data.translations[languageParameter].Price




            if data.translations.length > 0
                .lead !{data.translations[languageParameter].Lead}
                .content !{data.translations[languageParameter].Content}
        div#back(onclick="historyBack()")
                div
                div
                div
        script.
            //- CMS rich-text images (.content/.lead) carry the file library's title as
            //- their alt text (auto-filled by the Directus editor on insert) - reuse it
            //- as a caption underneath each image instead of fetching it separately.
            //- (event.pug doesn't include footer.pug/main.js, so this is duplicated here.)
            function captionContentImages(scope){
                (scope || document).querySelectorAll('.content img[alt], .lead img[alt]').forEach(function(img){
                    if(img.dataset.captioned) return;
                    img.dataset.captioned = '1';
                    var alt = (img.getAttribute('alt') || '').trim();
                    if(!alt) return;
                    var block = img.closest('p') || img.parentElement;
                    var caption = document.createElement('p');
                    caption.className = 'mediaCaption';
                    caption.textContent = alt;
                    block.insertAdjacentElement('afterend', caption);
                });
            }
            captionContentImages();

            function toggleMainVideoSound(){
                var v = document.getElementById('mainVideo');
                var b = document.getElementById('unmuteBtn');
                if(!v) return;
                v.muted = !v.muted;
                if(b){
                    b.classList.toggle('is-muted', v.muted);
                    b.setAttribute('aria-label', v.muted ? 'Ton aktivieren' : 'Ton stummschalten');
                }
            }

            (function(){
                var v = document.getElementById('mainVideo');
                var b = document.getElementById('playPauseBtn');
                if(!v || !b) return;
                function syncPlayPause(){
                    b.classList.toggle('is-paused', v.paused);
                    b.setAttribute('aria-label', v.paused ? 'Abspielen' : 'Pause');
                }
                v.addEventListener('play', syncPlayPause);
                v.addEventListener('pause', syncPlayPause);
                syncPlayPause();
                b.addEventListener('click', function(){
                    if(v.paused){ v.play(); } else { v.pause(); }
                });
            })();

            //- this page is loaded inside the overlay iframe on the timetable/artists pages;
            //- links here (including ones from CMS rich-text content) must escape the iframe
            //- instead of loading a full nested page (with its own nav) inside it.
            if(window.top !== window.self){
                document.addEventListener('click', function(e){
                    if(e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
                    var a = e.target.closest && e.target.closest('a[href]');
                    if(!a || a.target === '_top' || a.target === '_blank') return;
                    var raw = a.getAttribute('href') || '';
                    if(raw.charAt(0) === '#' || raw.indexOf('mailto:') === 0 || raw.indexOf('tel:') === 0) return;

                    e.preventDefault();
                    var match = raw.match(/events\/([^\/?#]+)(?:\/(de|en))?/);
                    if(match && typeof window.top.openEventOverlay === 'function'){
                        var overlayUrl = window.top.location.origin + '/events/' + match[1] + (match[2] ? '/' + match[2] : '');
                        window.top.openEventOverlay(overlayUrl);
                    } else {
                        window.top.location.href = a.href;
                    }
                });
            }