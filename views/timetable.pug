html(lang=language[0])
    include includes/head.pug
    - var hourHeight = 5;
    script.
        var hourHeight = #{hourHeight};
    script(src=baseURL+"static/script/timetable.js")

    body.timetable(data-size='1')
        include includes/sitenav.pug

        - var hourStart = 9;
        - var hoursPerDay = 17;
        - var dayOutput = {14: ['Mittwoch, 14. Oktober', 'Wednesday, 14 October'], 15: ['Donnerstag, 15. Oktober', 'Thursday, 15 October'], 16: ['Freitag, 16. Oktober', 'Friday, 16 October'], 17: ['Samstag, 17. Oktober', 'Saturday, 17 October'], 18: ['Sonntag, 18. Oktober', 'Sunday, 18 October']}
        - var dayAbbr = {14: ['Mi','We'], 15: ['Do','Th'], 16: ['Fr','Fr'], 17: ['Sa','Sa'], 18: ['So','Su']};
        - var formats = ['ausstellungen','screenings','diskurs','konferenz','performances','clubnights','opening'];
        - var formatsTranslation = {ausstellungen: ['Ausstellung','Exhibtion'], konferenz: ['Konferenz','Conference'],performances: ['Performance','Performance'],  diskurs: ['Talks & Panels','Talks & Panels'], screenings: ['Screening','Screening'], clubnights: ['Club Night','Club Night'], workshop: ['Workshop','Workshop'], opening: ['Opening','Opening'], welcomming: ['Welcome','Welcome'], welcoming: ['Welcome','Welcome'], guided_tour: ['Führung', 'Guided Tour']};

        - var eventTranslation = function(evt, langParam){ var t = evt.translations || []; return t[langParam] || t[0] || {}; };

        //- ---- Spalten-Konfiguration ----
        //- Spalten entsprechen den Werten 1-7 des Feldes Row_in_Timetable.
        - var allColumns = [1,2,3,4,5,6,7].map(function(row){ return { id: row, label: ' ', row: row }; });

        - var id = 1;
        //#filters
            .bubble#filteropen(onclick="toggleFilter()") Filter

            .mediumpill.bubble.active#filterAll(onclick="filterTimetableAll()",data-all='1')='All'
            each format in formats
                .mediumpill.bubble.filterpill(onclick="filterTimetable('"+format+"',$(this))",data-visible=1,id="filter-"+format)=formatsTranslation[format][languageParameter]

        //    .mediumpill.bubble.active#filtermap(onclick="$('#map').toggle();")='Map'
        //- #map
        //-     img(src=imgURL+"5850ee5c-5b08-4fe4-ad9b-186dcf9044ab.png",onclick="$('#map').hide();")

        main
            #dayNav
                each day, dayIndex in [14,15,16,17,18]
                    .dayNavItem(class=dayIndex==0?'active':'',data-day-index=dayIndex,onclick="goToDay("+dayIndex+")")
                        span.dayAbbr= dayAbbr[day][languageParameter]
                        span.dayFull= dayOutput[day][languageParameter]
            .timetableSlider

                .timetableSliderTrack
                    //day
                    each day, dayIndex in [14,15,16,17,18]
                        .timetableDaySlide(data-day-index=dayIndex)
                            div(class="timetableDay")
                                - var n = hourStart;
                                .timetableHourlineWrap(data-hour=n)
                                    while n < hoursPerDay+hourStart+1
                                        .timetableHourline(style="height:"+hourHeight+"em;",id="timetableHourline"+day+'-'+n)
                                            if(n < 24)
                                                - var timePrint = n
                                            else
                                                - var timePrint = n-24
                                            .hourlineChar= timePrint+':00'
                                            - n++
                                #time

                            .timetableSpalteWrap
                                //- Spalten in aufsteigender Row_in_Timetable-Reihenfolge (1-7)
                                each column in allColumns
                                    - var dayEvents = events.filter(function(e){ if(e.Venues[0] === undefined || e.status != 'published' || !e.In_Timetable || e.Hour === '' || e.Day != day){ return false; } return Number(e.Row_in_Timetable) === column.row; })
                                    if dayEvents.length > 0
                                        - var hourBefore = hourStart
                                        - var firstEventInColumn = true
                                        .timetableSpalte(class="timetableSpalte"+column.id)
                                            .timetableSpalteLabel= column.label
                                            each event in dayEvents
                                                - var eventHour = parseInt(event.Hour) + (parseInt(event.Minute)/60)
                                                - var effHour = eventHour < hourStart ? hourStart : eventHour
                                                - var minuteOffset = effHour - Math.floor(effHour)
                                                - if(firstEventInColumn) var hourMargin = effHour - hourStart
                                                - else var hourMargin = effHour - hourBefore
                                                if(event.Timetable_only == '1')
                                                    .EventTimetableA(class='A'+event.Format+' EventTimetableTimetableOnly',style="height:"+((event.HourEnd - effHour)*hourHeight)+"em;margin-top:"+(minuteOffset*hourHeight)+"em;top:"+(hourMargin*hourHeight)+"em;",data-day=event.Day,data-end=event.HourEnd,data-hour=effHour,data-top=hourMargin*hourHeight,data-topedit=hourMargin*hourHeight,data-column=column.id,data-id=id,id="Event-"+id)
                                                        .EventTimetable(class=event.Format,style="min-height:"+((event.HourEnd - parseInt(event.Hour) - (parseInt(event.Minute)/60))*hourHeight)+"em;")
                                                            .EventTimetableContent !{eventTranslation(event, languageParameter).Content}
                                                else
                                                    a(href=baseURL+'events/'+event.slug+'/'+language[0])
                                                        .EventTimetableA(class='A'+event.Format,style="height:"+((event.HourEnd - effHour)*hourHeight)+"em;margin-top:"+(minuteOffset*hourHeight)+"em;top:"+(hourMargin*hourHeight)+"em;",data-day=event.Day,data-end=event.HourEnd,data-hour=effHour,data-top=hourMargin*hourHeight,data-topedit=hourMargin*hourHeight,data-column=column.id,data-id=id,id="Event-"+id)
                                                            .EventTimetable(class=event.Format,style="min-height:"+((event.HourEnd - parseInt(event.Hour) - (parseInt(event.Minute)/60))*hourHeight)+"em;")
                                                                if(formatsTranslation[event.Format] !== undefined)
                                                                    h3.format=formatsTranslation[event.Format][languageParameter]
                                                                - var hasSubformat = event.Subformat && event.Subformat.trim()
                                                                if(hasSubformat)
                                                                    h4.subformat=event.Subformat
                                                                h2.title(class=hasSubformat ? '' : 'title-narrow')!='<span class="bullet">•</span>'+(eventTranslation(event, languageParameter).Title || '')
                                                                //h2.artist=event.Artist
                                                                - var hourEndDisplay = ('0' + (Math.floor(event.HourEnd) % 24)).slice(-2)
                                                                if(venues[event.Venues[0].Venues_id] !== undefined)
                                                                    h4.time!=event.Hour+':'+(event.Minute || '00')+'&ndash;'+hourEndDisplay+':'+(event.MinuteEnd || '00')+' / '+venues[event.Venues[0].Venues_id].Name
                                                - hourBefore = event.HourEnd
                                                - firstEventInColumn = false
                                                - id++

        include includes/footer.pug
