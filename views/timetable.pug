html(lang=language[0])
    include includes/head.pug
    - var hourHeight = 5;
    script.
        var hourHeight = #{hourHeight};
    script(src=baseURL+"static/script/timetable.js")

    body.timetable(data-size='1')
        include includes/sitenav.pug

        - var hourStart = 9;
        - var hoursPerDay = 17;
        - var dayOutput = {14: ['Mittwoch, 14. Oktober', 'Wednesday'], 15: ['Donnerstag, 15. Oktober', 'Thursday'], 16: ['Freitag, 16. Oktober', 'Friday'], 17: ['Samstag, 17. Oktober', 'Saturday'], 18: ['Sonntag, 18. Oktober', 'Sunday']}
        - var dayAbbr = {14: 'Mi', 15: 'Do', 16: 'Fr', 17: 'Sa', 18: 'So'};
        - var formats = ['ausstellungen','screenings','diskurs','konferenz','performances','clubnights'];
        - var formatsTranslation = {ausstellungen: ['Ausstellung','Exhibtion'], konferenz: ['Konferenz','Conference'],performances: ['Performance','Performance'],  diskurs: ['Talks & Panels','Talks & Panels'], screenings: ['Screening','Screening'], clubnights: ['Club Night','Club Night'], workshops: ['Workshop','Workshop'], workshop: ['Workshop','Workshop']};

        - var themaSlug = function(thema){ var slug = thema.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/(^-|-$)/g,''); return slug || 'other'; };
        - var themaList = [];
        - events.forEach(function(e){ if(e.status == 'published' && e.In_Timetable && e.Thema && themaList.indexOf(e.Thema) === -1){ themaList.push(e.Thema); } });
        - themaList.sort().reverse();

        - var id = 1;
        //#filters
            .bubble#filteropen(onclick="toggleFilter()") Filter

            .mediumpill.bubble.active#filterAll(onclick="filterTimetableAll()",data-all='1')='All'
            each format in formats
                .mediumpill.bubble.filterpill(onclick="filterTimetable('"+format+"',$(this))",data-visible=1,id="filter-"+format)=formatsTranslation[format][languageParameter]

        //    .mediumpill.bubble.active#filtermap(onclick="$('#map').toggle();")='Map'
        //- #map
        //-     img(src=imgURL+"5850ee5c-5b08-4fe4-ad9b-186dcf9044ab.png",onclick="$('#map').hide();")

        main
            #dayNav
                each day, dayIndex in [14,15,16,17,18]
                    .dayNavItem(class=dayIndex==0?'active':'',data-day-index=dayIndex,onclick="goToDay("+dayIndex+")")
                        span.dayAbbr= dayAbbr[day]
                        span.dayFull= dayOutput[day][0]
            .timetableSlider

                .timetableSliderTrack
                    //day
                    each day, dayIndex in [14,15,16,17,18]
                        .timetableDaySlide(data-day-index=dayIndex)
                            div(class="timetableDay")
                                - var n = hourStart;
                                .timetableHourlineWrap(data-hour=n)
                                    while n < hoursPerDay+hourStart+1
                                        .timetableHourline(style="height:"+hourHeight+"em;",id="timetableHourline"+day+'-'+n)
                                            if(n < 24)
                                                - var timePrint = n
                                            else
                                                - var timePrint = n-24
                                            .hourlineChar= timePrint+':00'
                                            - n++
                                #time

                            .timetableSpalteWrap
                                //thema
                                each thema in themaList
                                    - var dayEvents = events.filter(function(e){ return e.Venues[0] !== undefined && e.status == 'published' && e.In_Timetable && e.Thema == thema && e.Hour !== '' && e.Day == day; })
                                    if dayEvents.length > 0
                                        - var hourBefore = hourStart
                                        - var firstEventInColumn = true
                                        .timetableSpalte(class="timetableSpalte"+themaSlug(thema))
                                            .timetableSpalteLabel= thema
                                            each event in dayEvents
                                                - var eventHour = parseInt(event.Hour) + (parseInt(event.Minute)/60)
                                                - var effHour = eventHour < hourStart ? hourStart : eventHour
                                                - var minuteOffset = effHour - Math.floor(effHour)
                                                - if(firstEventInColumn) var hourMargin = effHour - hourStart
                                                - else var hourMargin = effHour - hourBefore
                                                - if(event.Timetable_only !== '1') var Timetable_only = true

                                                if(event.Artist == 'Ausstellungen im Timetable')
                                                    a(href=baseURL+'ausstellungen/'+language[0])
                                                        .EventTimetableA(class='A'+event.Format+' EventTimetableAusstellungenLink',style="height:"+((event.HourEnd - effHour)*hourHeight)+"em;margin-top:"+(minuteOffset*hourHeight)+"em;top:"+(hourMargin*hourHeight)+"em;",data-day=event.Day,data-end=event.HourEnd,data-hour=effHour,data-top=hourMargin*hourHeight,data-topedit=hourMargin*hourHeight,data-column=themaSlug(thema),data-id=id,id="Event-"+id)
                                                            .EventTimetable(class=event.Format,style="min-height:"+((event.HourEnd - parseInt(event.Hour) - (parseInt(event.Minute)/60))*hourHeight)+"em;")
                                                                h2.title= event.translations[languageParameter] !== undefined ? event.translations[languageParameter].Title : event.translations[0].Title
                                                                - var hourEndDisplay = ('0' + (Math.floor(event.HourEnd) % 24)).slice(-2)
                                                                h3.time!=event.Hour+':'+(event.Minute || '00')+'&ndash;'+hourEndDisplay+':'+(event.MinuteEnd || '00')
                                                else
                                                    #{event.Timetable_only == '1' ? 'div' : 'a'}(href=baseURL+'events/'+event.slug+'/'+language[0])
                                                        .EventTimetableA(class='A'+event.Format,style="height:"+((event.HourEnd - effHour)*hourHeight)+"em;margin-top:"+(minuteOffset*hourHeight)+"em;top:"+(hourMargin*hourHeight)+"em;",data-day=event.Day,data-end=event.HourEnd,data-hour=effHour,data-top=hourMargin*hourHeight,data-topedit=hourMargin*hourHeight,data-column=themaSlug(thema),data-id=id,id="Event-"+id)
                                                            .EventTimetable(class=event.Format,style="min-height:"+((event.HourEnd - parseInt(event.Hour) - (parseInt(event.Minute)/60))*hourHeight)+"em;")
                                                                if(event.Timetable_only == '1')
                                                                    if(event.translations[languageParameter] !== undefined)
                                                                        .EventTimetableContent !{event.translations[languageParameter].Content}
                                                                    else
                                                                        .EventTimetableContent !{event.translations[0].Content}
                                                                else
                                                                    if(formatsTranslation[event.Format] !== undefined)
                                                                        h3.format=formatsTranslation[event.Format][languageParameter]
                                                                    h2.title!=event.translations[languageParameter] !== undefined ? '<span class="bullet">• </span>'+event.translations[languageParameter].Title : '<span class="bullet">• </span>'+event.translations[0].Title
                                                                    //h2.artist=event.Artist
                                                                    - var hourEndDisplay = ('0' + (Math.floor(event.HourEnd) % 24)).slice(-2)
                                                                    if(venues[event.Venues[0].Venues_id] !== undefined)
                                                                        h3.time!=event.Hour+':'+(event.Minute || '00')+'&ndash;'+hourEndDisplay+':'+(event.MinuteEnd || '00')+' / '+venues[event.Venues[0].Venues_id].Name
                                                - hourBefore = event.HourEnd
                                                - firstEventInColumn = false
                                                - id++

        include includes/footer.pug
