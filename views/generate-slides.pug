doctype html
html(lang="de")
    head
        meta(charset="utf-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        meta(name="robots" content="noindex")
        title Mesh – Title-Slide Generator
        link(rel="icon" type="image/png" sizes="32x32" href=baseURL+"static/img/favicon/favicon-32x32.png")
        style.
            @font-face{font-family:"FreeSans-JK";src:url("#{baseURL}static/fonts/JK-MESH-Sans.woff2") format("woff2"),url("#{baseURL}static/fonts/JK-MESH-Sans.woff") format("woff");font-weight:700;font-display:swap;}
            @font-face{font-family:"FreeSerif-JK";src:url("#{baseURL}static/fonts/JK-MESH-Serif.woff2") format("woff2"),url("#{baseURL}static/fonts/JK-MESH-Serif.woff") format("woff");font-weight:500;font-display:swap;}

            *,*::before,*::after{box-sizing:border-box;}
            html,body{margin:0;}
            body{
                background:#fef7f6;
                color:#333;
                font-family:"FreeSans-JK",-apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif;
                -webkit-font-smoothing:antialiased;
                line-height:1.45;
            }
            .tool{max-width:1180px;margin:0 auto;padding:clamp(1.25rem,4vw,3rem);}
            .tool__head{margin-bottom:2.25rem;}
            .tool__head h1{
                font-family:"FreeSerif-JK",Georgia,serif;
                font-weight:500;
                font-size:clamp(1.9rem,4vw,2.9rem);
                margin:0 0 .5rem;
            }
            .tool__head p{margin:0;max-width:62ch;opacity:.82;}
            .tool__grid{
                display:grid;
                grid-template-columns:340px minmax(0,1fr);
                gap:clamp(1.5rem,4vw,3rem);
                align-items:start;
            }
            @media (max-width:860px){ .tool__grid{grid-template-columns:1fr;} }
            .controls{display:flex;flex-direction:column;gap:1.35rem;}
            .field{display:flex;flex-direction:column;gap:.45rem;}
            .field label,.radios legend{font-weight:700;font-size:.95rem;}
            .field input,.field textarea{
                font:inherit;
                color:#333;
                background:#fff;
                border:1px solid rgba(51,51,51,.22);
                border-radius:2px;
                padding:.6rem .7rem;
                width:100%;
            }
            .field textarea{min-height:5rem;resize:vertical;}
            .field input:focus,.field textarea:focus{outline:2px solid #333;outline-offset:1px;}
            .radios{border:0;margin:0;padding:0;display:flex;flex-direction:column;gap:.5rem;}
            .radios legend{padding:0;margin-bottom:.35rem;}
            .radio{display:flex;align-items:center;gap:.5rem;font-size:.95rem;cursor:pointer;}
            .btn{
                font:inherit;font-weight:700;
                background:#333;color:#fef7f6;
                border:none;border-radius:2px;
                padding:.85rem 1.3rem;
                cursor:pointer;
                align-self:flex-start;
            }
            .btn:hover{opacity:.88;}
            .btn:disabled{opacity:.5;cursor:default;}
            .hint{font-size:.8rem;opacity:.65;margin:0;}
            .toggle{
                font:inherit;font-weight:700;font-size:.95rem;
                display:inline-flex;align-items:center;gap:.5rem;
                background:#fff;color:#333;
                border:1px solid rgba(51,51,51,.22);border-radius:2px;
                padding:.55rem .85rem;cursor:pointer;align-self:flex-start;
            }
            .toggle::before{
                content:"";width:.85rem;height:.85rem;flex:0 0 auto;
                border:2px solid currentColor;border-radius:2px;
            }
            .toggle[aria-pressed="true"]{background:#333;color:#fef7f6;border-color:#333;}
            .toggle[aria-pressed="true"]::before{background:currentColor;}
            .toggle:disabled{opacity:.5;cursor:default;}
            .preview{width:100%;}
            .preview__frame{
                width:100%;
                aspect-ratio:16/9;
                border:1px solid rgba(51,51,51,.18);
                background:#fef7f6;
                overflow:hidden;
            }
            #previewCanvas{display:block;width:100%;height:100%;}
            .preview__meta{font-size:.8rem;opacity:.65;margin:.65rem 0 0;}
    body
        main.tool
            header.tool__head
                h1 Title-Slide Generator
                p Erstelle deine persönliche Titelfolie für deinen Beitrag am Mesh Festival: Name und Vortragstitel eingeben, dann als JPG herunterladen. — Create your personal title slide, then download it as a JPG.
            .tool__grid
                .controls
                    .field
                        label(for="nameInput") Name
                        textarea#nameInput(rows="2" spellcheck="false")
                    .field
                        label(for="titleInput") Titel der Präsentation / Presentation title
                        textarea#titleInput(rows="3" spellcheck="false")
                    fieldset.radios
                        legend Auflösung / Resolution
                        label.radio
                            input(type="radio" name="res" value="1920" checked)
                            span 1920 × 1080 (Full HD)
                        label.radio
                            input(type="radio" name="res" value="3840")
                            span 3840 × 2160 (4K)
                    button#logosToggle.toggle(type="button" aria-pressed="true") Logos
                    button#downloadBtn.btn(type="button") JPG herunterladen / Download JPG
                    p.hint Format 16:9, gespeichert als JPG.
                .preview
                    .preview__frame
                        canvas#previewCanvas
                    p.preview__meta Live-Vorschau – die heruntergeladene Datei entspricht 1:1 der Vorschau, nur hochauflösend.
        script.
            (function(){
                var BASE = "#{baseURL}";
                // Three background variants – one is picked at random per page load
                // (stays the same for preview + download so they match 1:1; reload for a new one).
                // The "Logos" toggle swaps between the normal file and its -NOLOGO version.
                var VARIANTS = [
                    "static/img/MESH-PRESENTATION-SLIDES1",
                    "static/img/MESH-PRESENTATION-SLIDES2",
                    "static/img/MESH-PRESENTATION-SLIDES3"
                ];
                var variantIndex = Math.floor(Math.random() * VARIANTS.length);
                var withLogos = true;
                var DEFAULTS = { name: "Name", title: "Title" };
                var PREVIEW_WIDTH = 1600;

                // Layout constants, as fractions of canvas WIDTH (canvas is fixed 16:9),
                // except marginTop / maxBlock which are fractions of HEIGHT.
                var L = {
                    marginX: 0.018,
                    marginTop: 0.038,
                    maxBlock: 0.62,          // text block must stay within the top 62% (clear of artwork/footer)
                    nameSize: 0.082 * 1.14,  // line 1 (name)
                    titleSize: 0.082 * 1.23, // line 2 (presentation title)
                    minSize: 0.040,          // floor for the smaller of the two, before shrinking stops
                    lineHeight: 0.9,
                    blockGap: 0.0,          // * titleSize, between name block and title block
                    letterSpacing: "-0.05em" // tracking on the rendered slide text; em = relative to each line's font size
                };

                var nameInput = document.getElementById("nameInput");
                var titleInput = document.getElementById("titleInput");
                var downloadBtn = document.getElementById("downloadBtn");
                var logosToggle = document.getElementById("logosToggle");
                var previewCanvas = document.getElementById("previewCanvas");

                var bgImage = new Image();
                var bgReady;
                function loadBg(){
                    var src = BASE + VARIANTS[variantIndex] + (withLogos ? "" : "-NOLOGO") + ".jpg";
                    bgReady = new Promise(function(resolve, reject){
                        if(bgImage.src === src && bgImage.complete && bgImage.naturalWidth){ resolve(); return; }
                        bgImage.onload = function(){ resolve(); };
                        bgImage.onerror = function(){ reject(new Error("Hintergrundbild konnte nicht geladen werden.")); };
                        bgImage.src = src;
                    });
                    return bgReady;
                }
                loadBg();

                function selectedRes(){
                    var checked = document.querySelector('input[name="res"]:checked');
                    return checked ? parseInt(checked.value, 10) : 1920;
                }

                function wrapText(ctx, text, maxWidth){
                    var lines = [];
                    String(text).split("\n").forEach(function(paragraph){
                        var words = paragraph.split(/\s+/).filter(Boolean);
                        if(!words.length){ lines.push(""); return; }
                        var current = words[0];
                        for(var i = 1; i < words.length; i++){
                            var test = current + " " + words[i];
                            if(ctx.measureText(test).width <= maxWidth){
                                current = test;
                            } else {
                                lines.push(current);
                                current = words[i];
                            }
                        }
                        lines.push(current);
                    });
                    return lines;
                }

                // Shrink both font sizes proportionally until name + title fit the safe area.
                function fitLayout(ctx, W, H, nameText, titleText){
                    var maxWidth = W - L.marginX * W * 2;
                    var maxBlockH = L.maxBlock * H;
                    var minSize = L.minSize * W;
                    var scale = 1;
                    if("letterSpacing" in ctx){ ctx.letterSpacing = L.letterSpacing; }
                    var nameSize, titleSize, nameLines, titleLines, blockH;
                    while(true){
                        nameSize = L.nameSize * W * scale;
                        titleSize = L.titleSize * W * scale;
                        ctx.font = '700 ' + nameSize + 'px "FreeSans-JK", sans-serif';
                        nameLines = nameText ? wrapText(ctx, nameText, maxWidth) : [];
                        ctx.font = '500 ' + titleSize + 'px "FreeSerif-JK", serif';
                        titleLines = titleText ? wrapText(ctx, titleText, maxWidth) : [];
                        blockH = nameLines.length * nameSize * L.lineHeight
                            + (nameLines.length && titleLines.length ? titleSize * L.blockGap : 0)
                            + titleLines.length * titleSize * L.lineHeight;
                        if(blockH <= maxBlockH || Math.min(nameSize, titleSize) <= minSize) break;
                        scale *= 0.95;
                    }
                    return { nameSize: nameSize, titleSize: titleSize, nameLines: nameLines, titleLines: titleLines };
                }

                function draw(ctx, W, H){
                    var nameText = (nameInput.value || "").trim();
                    var titleText = (titleInput.value || "").trim();

                    ctx.clearRect(0, 0, W, H);
                    ctx.drawImage(bgImage, 0, 0, W, H);

                    ctx.fillStyle = "#333333";
                    ctx.textBaseline = "top";
                    ctx.textAlign = "left";
                    if("letterSpacing" in ctx){ ctx.letterSpacing = L.letterSpacing; }

                    var fit = fitLayout(ctx, W, H, nameText, titleText);
                    var marginX = L.marginX * W;
                    var y = L.marginTop * H;

                    if(fit.nameLines.length){
                        ctx.font = '700 ' + fit.nameSize + 'px "FreeSans-JK", sans-serif';
                        fit.nameLines.forEach(function(line){
                            ctx.fillText(line, marginX, y);
                            y += fit.nameSize * L.lineHeight;
                        });
                    }
                    if(fit.titleLines.length){
                        if(fit.nameLines.length){ y += fit.titleSize * L.blockGap; }
                        ctx.font = '500 ' + fit.titleSize + 'px "FreeSerif-JK", serif';
                        fit.titleLines.forEach(function(line){
                            ctx.fillText(line, marginX, y);
                            y += fit.titleSize * L.lineHeight;
                        });
                    }
                }

                async function ensureFonts(size){
                    if(!document.fonts || !document.fonts.load) return;
                    try {
                        await Promise.all([
                            document.fonts.load('700 ' + size + 'px "FreeSans-JK"'),
                            document.fonts.load('500 ' + size + 'px "FreeSerif-JK"')
                        ]);
                    } catch(e){ /* fall back to system fonts */ }
                }

                function renderToCanvas(canvas, width){
                    var W = width;
                    var H = Math.round(W * 9 / 16);
                    canvas.width = W;
                    canvas.height = H;
                    draw(canvas.getContext("2d"), W, H);
                }

                var previewReady = false;
                async function renderPreview(){
                    await bgReady;
                    await ensureFonts(200);
                    renderToCanvas(previewCanvas, PREVIEW_WIDTH);
                    previewReady = true;
                }

                nameInput.addEventListener("input", function(){ if(previewReady) renderToCanvas(previewCanvas, PREVIEW_WIDTH); });
                titleInput.addEventListener("input", function(){ if(previewReady) renderToCanvas(previewCanvas, PREVIEW_WIDTH); });

                [nameInput, titleInput].forEach(function(el){
                    el.addEventListener("focus", function(){ if(!el.dataset.touched){ el.select(); } });
                    el.addEventListener("input", function(){ el.dataset.touched = "1"; });
                });

                logosToggle.addEventListener("click", async function(){
                    withLogos = !withLogos;
                    logosToggle.setAttribute("aria-pressed", String(withLogos));
                    logosToggle.disabled = true;
                    try {
                        await loadBg();
                        if(previewReady) renderToCanvas(previewCanvas, PREVIEW_WIDTH);
                    } catch(e){
                        alert("Fehler: " + e.message);
                    } finally {
                        logosToggle.disabled = false;
                    }
                });

                function fileName(){
                    var slug = (nameInput.value || "mesh").toLowerCase()
                        .replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
                    return "mesh-title-slide" + (slug ? "-" + slug : "") + (withLogos ? "" : "-nologo") + ".jpg";
                }

                downloadBtn.addEventListener("click", async function(){
                    var label = downloadBtn.textContent;
                    downloadBtn.disabled = true;
                    downloadBtn.textContent = "Wird erstellt …";
                    try {
                        await bgReady;
                        var W = selectedRes();
                        await ensureFonts(Math.round(L.titleSize * W));
                        var out = document.createElement("canvas");
                        renderToCanvas(out, W);
                        await new Promise(function(resolve, reject){
                            out.toBlob(function(blob){
                                if(!blob){ reject(new Error("JPG konnte nicht erstellt werden.")); return; }
                                var url = URL.createObjectURL(blob);
                                var a = document.createElement("a");
                                a.href = url;
                                a.download = fileName();
                                document.body.appendChild(a);
                                a.click();
                                a.remove();
                                setTimeout(function(){ URL.revokeObjectURL(url); }, 4000);
                                resolve();
                            }, "image/jpeg", 0.92);
                        });
                    } catch(err){
                        alert("Fehler: " + err.message);
                    } finally {
                        downloadBtn.disabled = false;
                        downloadBtn.textContent = label;
                    }
                });

                nameInput.value = DEFAULTS.name;
                titleInput.value = DEFAULTS.title;
                renderPreview();
                if(document.fonts && document.fonts.ready){
                    document.fonts.ready.then(function(){ if(previewReady) renderToCanvas(previewCanvas, PREVIEW_WIDTH); });
                }
            })();
