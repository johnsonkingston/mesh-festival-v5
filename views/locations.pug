doctype html
html(lang=language[0])
    include includes/head.pug
    body.visit
        include includes/sitenav.pug

        .splashImage
            img(src="https://env-9468449.appengine.flow.ch/assets/fc1485d5-7a10-48ca-8dec-939c7dfd730e.jpg?key=fullscreen", alt="Locations")

        main
            if data.translations.length > 0
                if(data.translations[languageParameter] === undefined)
                    h1= data.translations[0].Title
                else
                    h1= data.translations[languageParameter].Title

            .venueOverview
                each venue in venues
                    .venueItem
                        if venue.image
                            img(src=imgURL+venue.image.filename_disk+'?key=content', alt=venue.Name)
                        .caption.venueTitle= venue.Name

            if data.Events.length > 0
                .eventswrapper
                    each val in data.Events
                        - var caption =val.Events_id.Artist
                        if(val.Events_id.status == 'published' || val.Events_id.status == 'preview')
                            - var gridId = Math.floor(Math.random() * (1 - 10) + 10)
                            if(val.Events_id.status == 'preview')
                                a
                                    .events
                                        .eventimg(style='background-image:url('+imgURL+val.Events_id.Main_Image+'?key=icon)')
                                            img(src=baseURL+'static/img/grid-square-'+gridId+'.png', alt=val.Events_id.Artist)
                                        .caption &bull; #{caption}
                            else
                                a(href=baseURL+'events/'+val.Events_id.slug+'/'+language[0])
                                    .events
                                        .eventimg(style='background-image:url('+imgURL+val.Events_id.Main_Image+'?key=icon)')
                                            img(src=baseURL+'static/img/grid-square-'+gridId+'.png', alt=val.Events_id.Artist)
                                            if val.Events_id.Label_Overview !== null
                                                .label=val.Events_id.Label_Overview
                                        .caption &bull; #{caption}
            script.
                $( document ).ready(function() {
                    isOverflown();
                });


        include includes/footer.pug
