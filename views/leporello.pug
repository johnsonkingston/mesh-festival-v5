doctype html
html(lang=language[0])
    head
        meta(charset="utf-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        meta(name="robots" content="noindex")
        title Mesh – Programm Leporello
        link(rel="icon" type="image/png" sizes="32x32" href=baseURL+"static/img/favicon/favicon-32x32.png")
        style#pageStyle.
            @page{ size:525mm 297mm; margin:0; }
        style.
            @font-face{font-family:"FreeSans-JK";src:url("#{baseURL}static/fonts/JK-MESH-Sans.woff2") format("woff2"),url("#{baseURL}static/fonts/JK-MESH-Sans.woff") format("woff");font-weight:700;font-display:swap;}
            @font-face{font-family:"FreeSerif-JK";src:url("#{baseURL}static/fonts/JK-MESH-Serif.woff2") format("woff2"),url("#{baseURL}static/fonts/JK-MESH-Serif.woff") format("woff");font-weight:500;font-display:swap;}

            :root{
                --bg:#ffffff;
                --ink:#000;
                --rule:rgba(51,51,51,.22);
                --tscale:0.81;
            }
            *,*::before,*::after{box-sizing:border-box;}
            html,body{margin:0;}
            body{
                background:#dcdcdc;color:var(--ink);
                font-family:"FreeSans-JK",-apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif;
                -webkit-font-smoothing:antialiased;
            }

            .toolbar{
                position:sticky;top:0;z-index:5;display:flex;align-items:center;gap:.8rem;
                padding:.7rem 1rem;background:var(--bg);border-bottom:1px solid var(--rule);
            }
            .toolbar span{font-size:.85rem;opacity:.7;}
            .tb-btn{
                font:inherit;font-weight:700;background:var(--ink);color:var(--bg);
                border:none;border-radius:2px;padding:.55rem 1rem;cursor:pointer;margin-left:auto;
            }
            .tb-btn:hover{opacity:.88;}

            .stage{padding:24px 16px 48px;display:flex;flex-direction:column;align-items:center;gap:24px;overflow:auto;}
            .sheet-clip{overflow:hidden;background:#fff;box-shadow:0 2px 24px rgba(0,0,0,.18);}
            /* the sheet's own background is the pre-designed full-bleed artwork (site
               map, title, sponsors) - both files are laid out at the sheet's exact
               525x297mm, with the panel columns that carry dynamic content (day/
               exhibition tables) left blank in the artwork itself, so the HTML table
               overlay and the background never fight for the same space. */
            .sheet{
                position:relative;width:525mm;height:297mm;background:var(--bg) no-repeat center/100% 100%;
                display:grid;grid-template-columns:repeat(5,1fr);grid-template-rows:297mm;
                transform:scale(var(--scale,1));transform-origin:top left;
            }
            .sheet--front{background-image:url("#{baseURL}static/img/leporello/MESH-LEPORELLO-VS.png");}
            .sheet--back{background-image:url("#{baseURL}static/img/leporello/MESH-LEPORELLO-RS.png");}

            /* ---- panels: headers are generated with CSS, fold guides are just a dashed rule ---- */
            /* min-height:0 forces this grid item to respect its 297mm row track instead of
               growing to fit overflowing content - some print engines (Safari in particular)
               otherwise ignore overflow:hidden here and spill extra pages instead of clipping. */
            .panel{position:relative;display:flex;flex-direction:column;overflow:hidden;padding:3mm 3mm 10mm;min-height:0;}
            .panel + .panel{border-left:.35mm dashed var(--rule);}

            .panel__head{
                position:relative;
                display:flex;flex-direction:column;gap:1mm;
                padding: 0;
                background:#fff;color:#000;
                height: 13.6mm;
                overflow: hidden;
                margin-left: -1mm;
            }

            .panel__day{font-family:"FreeSans-JK",-apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif;font-weight:700;font-size:15mm;line-height:17mm;margin:0; margin-top:-2mm;color:#000;letter-spacing:-1mm;}
            /* a day heading inside the flowing table (see layoutFlow() below) instead of
               a fixed .panel__head - days run straight on from one another, so the next
               day's heading can land anywhere in a column, not just at its top. */
            .p-table tr.p-dayrow td{border-bottom:none;padding:4mm 0 2mm;}
            .p-table tr.p-dayrow:first-child td{padding-top:0;}

            /* programme table – same columns/structure as screens.pug's #poster .p-table */
            .panel__list{position:relative;z-index:1;overflow:hidden;}
            .p-table{width:100%;table-layout:fixed;border-collapse:collapse;}
            .p-table col.col-time{width:10%;}
            .p-table col.col-title{width:32%;}
            .p-table col.col-artist{width:36%;}
            .p-table col.col-venue{width:22%;}
            /* exhibitions have no fixed time slot – their list drops the time column
               and redistributes its width across the remaining three */
            .p-table--noTime col.col-title{width:34%;}
            .p-table--noTime col.col-artist{width:41%;}
            .p-table--noTime col.col-venue{width:25%;}
            .panel__note{
                margin:6mm 0 2mm;text-align:center;
                font-size:calc(3mm * var(--tscale,0.82));line-height:1.15;
            }
            .p-table td{
                padding:calc(1mm * var(--tscale,0.82)) calc(1mm * var(--tscale,0.82)) calc(1mm * var(--tscale,0.82)) 0;
                border-bottom:.2mm solid var(--ink);
                font-size:calc(3mm * var(--tscale,0.82));line-height:1.15;vertical-align:top;
                word-wrap:break-word;overflow-wrap:break-word;
            }
            .p-table td.c-title{font-weight:700;}
            /* narrower than screens.pug's 1080px poster – "hh:mm – hh:mm" needs to
               wrap onto two lines here instead of forcing nowrap, or it overlaps c-title */
            .p-table tr.p-secrow td{
                border-bottom:none;padding:calc(2mm * var(--tscale,0.82)) 0 calc(1.4mm * var(--tscale,0.82));text-align:center;
            }
            .p-table .p-pill{
                display:inline-block;background:var(--ink);color:var(--bg);
                border-radius:1.2mm;padding:.15em .5em;font-weight:500;font-size:calc(3mm * var(--tscale,0.82));
            }
            .panel__empty{margin-top:14mm;text-align:center;font-size:4mm;opacity:.5;}
            .panel__blank{flex:1;}
            /* screen-only QA flag: content still overflows after auto-shrink hit its floor */
            .panel.is-overflowing{outline:1.5mm solid #e0203c;outline-offset:-1.5mm;}
            .panel.is-overflowing::after{
                content:"Läuft über – kürzen";
                position:absolute;z-index:3;bottom:2mm;left:50%;transform:translateX(-50%);
                background:#e0203c;color:#fff;font-size:3mm;font-weight:700;
                padding:.6mm 2mm;border-radius:1mm;white-space:nowrap;
            }

            @media print{
                html,body{background:#fff !important;}
                .toolbar{display:none !important;}
                .panel.is-overflowing{outline:none;}
                .panel.is-overflowing::after{display:none;}
                .stage{display:block !important;padding:0 !important;overflow:visible !important;gap:0 !important;}
                .sheet-clip{overflow:visible !important;box-shadow:none !important;width:auto !important;height:auto !important;}
                .sheet-clip + .sheet-clip{page-break-before:always;}
                .sheet{transform:none !important;-webkit-print-color-adjust:exact;print-color-adjust:exact;}
            }
    body
        .toolbar
            span Leporello · 525×297mm quer · Zickzackfalz · 5 Panels je Seite
            button#printBtn.tb-btn(type="button") Drucken
        .stage#stage
            each sheet, sheetIndex in sheets
                .sheet-clip
                    .sheet(class=sheetIndex === 0 ? "sheet--front" : "sheet--back")
                        each panel, panelIndex in sheet
                            .panel
                                if panel && panel.isFlow
                                    .panel__list(data-flow-index=panel.flowIndex)
                                        table.p-table
                                            colgroup
                                                col.col-time
                                                col.col-title
                                                col.col-artist
                                                col.col-venue
                                            tbody
                                else if panel && panel.blocks && panel.blocks.length
                                    each block in panel.blocks
                                        .panel__head
                                            h2.panel__day= block.label
                                        .panel__list
                                            if block.isExhibition
                                                p.panel__note= block.note
                                                if block.items.length
                                                    table.p-table.p-table--noTime
                                                        colgroup
                                                            col.col-title
                                                            col.col-artist
                                                            col.col-venue
                                                        tbody
                                                            each item in block.items
                                                                tr
                                                                    td.c-title= item.title
                                                                    td.c-artist= item.artist
                                                                    td.c-venue= item.venue
                                                else
                                                    .panel__empty Kein Eintrag
                                            else if block.sections.length
                                                table.p-table
                                                    colgroup
                                                        col.col-time
                                                        col.col-title
                                                        col.col-artist
                                                        col.col-venue
                                                    tbody
                                                        each section in block.sections
                                                            tr.p-secrow
                                                                td(colspan="4")
                                                                    span.p-pill= section.label
                                                            each item in section.items
                                                                tr
                                                                    td.c-time= item.time
                                                                    td.c-title= item.title
                                                                    td.c-artist= item.artist
                                                                    td.c-venue= item.venue
                                            else
                                                .panel__empty Kein Eintrag
                                else
                                    .panel__blank
        script.
            (function(){
                var MM = 96 / 25.4;
                var stage = document.getElementById("stage");
                var printBtn = document.getElementById("printBtn");
                var FLOW_ROWS = !{JSON.stringify(flowRows)};

                function el(tag, cls, text){
                    var n = document.createElement(tag);
                    if(cls) n.className = cls;
                    if(text != null) n.textContent = text;
                    return n;
                }
                function td(cls, text){ return el("td", cls, text); }

                function buildFlowRow(row){
                    if(row.type === "day"){
                        var tr = el("tr", "p-dayrow");
                        var c = document.createElement("td");
                        c.colSpan = 4;
                        c.appendChild(el("h2", "panel__day", row.label));
                        tr.appendChild(c);
                        return tr;
                    }
                    if(row.type === "section"){
                        var tr = el("tr", "p-secrow");
                        var c = document.createElement("td");
                        c.colSpan = 4;
                        c.appendChild(el("span", "p-pill", row.label));
                        tr.appendChild(c);
                        return tr;
                    }
                    if(row.type === "empty"){
                        var tr = document.createElement("tr");
                        var c = document.createElement("td");
                        c.colSpan = 4;
                        c.appendChild(el("div", "panel__empty", "Kein Eintrag"));
                        tr.appendChild(c);
                        return tr;
                    }
                    var tr = document.createElement("tr");
                    tr.appendChild(td("c-time", row.time));
                    var cTitle = td("c-title");
                    cTitle.appendChild(document.createTextNode(row.title || ""));
                    tr.appendChild(cTitle);
                    tr.appendChild(td("c-artist", row.artist || ""));
                    tr.appendChild(td("c-venue", row.venue || ""));
                    return tr;
                }

                // Pours FLOW_ROWS through the 4 day panels (front sheet, panels 1-4 - panel
                // 5 is artwork) in order, filling each one until the next row would overflow
                // it, then continuing in the next panel - so a day runs on directly from the
                // previous one and can start, split, or end anywhere in a column. A heading/
                // section pill is never left dangling alone at the bottom of a column: if the
                // row after it doesn't fit, the heading/pill moves down to the next column too.
                function layoutFlow(){
                    var lists = Array.prototype.slice.call(document.querySelectorAll(".panel__list[data-flow-index]"));
                    lists.sort(function(a, b){ return Number(a.dataset.flowIndex) - Number(b.dataset.flowIndex); });
                    if(!lists.length) return;

                    var idx = 0;
                    lists.forEach(function(list){
                        var tbody = list.querySelector("tbody");
                        tbody.innerHTML = "";
                        if(idx >= FLOW_ROWS.length) return;

                        var pendingStart = null; // idx of the first not-yet-confirmed heading/pill in this column

                        while(idx < FLOW_ROWS.length){
                            var row = FLOW_ROWS[idx];
                            var tr = buildFlowRow(row);
                            tbody.appendChild(tr);

                            if(row.type === "day" || row.type === "section"){
                                if(pendingStart === null) pendingStart = idx;
                            } else {
                                pendingStart = null; // an event row confirms any pending heading/pill
                            }

                            if(list.scrollHeight > list.clientHeight){
                                if(tbody.children.length === 1){
                                    // a single row already overflows an empty column - keep it
                                    // rather than bounce it from column to column forever.
                                    idx++;
                                    break;
                                }
                                tbody.removeChild(tr);
                                if(pendingStart !== null){
                                    var removeCount = idx - pendingStart;
                                    for(var k = 0; k < removeCount; k++){
                                        tbody.removeChild(tbody.lastChild);
                                    }
                                    idx = pendingStart;
                                }
                                break;
                            }

                            idx++;
                        }
                    });

                    // ran out of panels before running out of rows (shouldn't normally
                    // happen) - dump the rest into the last panel rather than lose them
                    // silently; flagOverflow() below will flag it red for a manual trim.
                    if(idx < FLOW_ROWS.length){
                        var lastTbody = lists[lists.length - 1].querySelector("tbody");
                        for(; idx < FLOW_ROWS.length; idx++){
                            lastTbody.appendChild(buildFlowRow(FLOW_ROWS[idx]));
                        }
                    }
                }

                function fit(){
                    var w = 525 * MM, h = 297 * MM;
                    var availW = stage.clientWidth - 32;
                    var scale = Math.min(1, availW / w);
                    if(!isFinite(scale) || scale <= 0) scale = 1;
                    Array.prototype.forEach.call(document.querySelectorAll(".sheet"), function(s){
                        s.style.setProperty("--scale", scale);
                    });
                    Array.prototype.forEach.call(document.querySelectorAll(".sheet-clip"), function(c){
                        c.style.width = (w * scale) + "px";
                        c.style.height = (h * scale) + "px";
                    });
                }

                // Font size is fixed (--tscale is a constant, no per-panel scaling) –
                // this only flags panels whose content still overflows at that size,
                // it never changes the scale.
                function flagOverflow(){
                    Array.prototype.forEach.call(document.querySelectorAll(".panel"), function(panel){
                        // a panel can stack more than one day/exhibition block, each with
                        // its own .panel__list - flag the panel if any of them overflows.
                        var lists = panel.querySelectorAll(".panel__list");
                        if(!lists.length) return;
                        panel.classList.remove("is-overflowing");
                        // .panel__list flex-shrinks to fit .panel (overflow:hidden gives it an
                        // automatic min-height of 0), so it silently clips its own content
                        // without ever making .panel itself report an overflow - check each
                        // list's own scrollHeight/clientHeight instead.
                        var overflowing = Array.prototype.some.call(lists, function(list){
                            var tbody = list.querySelector("tbody");
                            // an empty flow column (every day already fit earlier) has no rows
                            // to overflow - skip it rather than flag it from stray box-model
                            // rounding on an empty table.
                            if(tbody && !tbody.children.length) return false;
                            return list.scrollHeight > list.clientHeight;
                        });
                        if(overflowing){
                            panel.classList.add("is-overflowing");
                        }
                    });
                }

                function runLayout(){
                    layoutFlow();
                    flagOverflow();
                }

                printBtn.addEventListener("click", function(){ window.print(); });
                window.addEventListener("resize", fit);
                fit();
                runLayout();
                // custom fonts load async (font-display:swap) and reflow text after
                // the first pass, which can silently invalidate where rows were split -
                // lay out and re-check again once real metrics are available.
                if(document.fonts && document.fonts.ready){
                    document.fonts.ready.then(runLayout);
                }
            })();
